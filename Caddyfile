{
	admin off
	auto_https off
}

# Railway injects PORT; 8080 is the fallback for `docker run` locally.
:{$PORT:8080} {
	root * /srv
	encode gzip

	# /rithika and /rushil are not files — they are the two invitations, and
	# each is served the same page, which picks its side from the path
	try_files {path} {path}/ /index.html
	file_server

	# The page itself must always be revalidated, or a guest keeps seeing a
	# stale invitation after the details change.
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# config.js carries the names, dates and venues — same reasoning.
	@config path /config.js
	header @config Cache-Control "public, max-age=0, must-revalidate"

	@static path *.css *.js *.svg *.png *.jpg *.webp *.woff2
	header @static Cache-Control "public, max-age=3600"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
